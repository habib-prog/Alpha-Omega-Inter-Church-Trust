{
  "rules": {
    "public_comments": {
      ".read": true,
      ".write": "auth != null",
      "$uid": {
        "$commentId": {
          ".validate": "newData.hasChildren(['text','name','role','image','uid','createdAt'])"
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "site_content": {
      ".read": true,
      ".write": "auth != null"
    },
    "super_admins": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "admin_activity_logs": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "user_login_logs": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
